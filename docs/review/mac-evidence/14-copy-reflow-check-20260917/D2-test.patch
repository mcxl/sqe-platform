+    // Temporary D2 diagnostic. Never part of an acceptance candidate.
+    private final class D2Issues: Sendable {
+        private let records = Mutex<[Data]>([])
+        func append(_ data: Data) { records.withLock { $0.append(data) } }
+        var snapshot: [Data] { records.withLock { $0 } }
+    }
