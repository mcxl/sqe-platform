+    func testCopyReflowCheck() {
+        let environment = ProcessInfo.processInfo.environment
+        guard let arm = environment["ACE_D2_ARM"], ["X", "Y"].contains(arm),
+              let countText = environment["ACE_D2_MAX_CALLS"], let maxCalls = Int(countText),
+              [2, 30].contains(maxCalls), environment["ACE_UI_TEST_APPEARANCE"] == nil else {
+            XCTFail("D2 requires arm X/Y, 2/30 post-copy calls, and no appearance override")
+            return
+        }
+        let forceFailure = environment["ACE_D2_FORCE_FAIL"] == "1"
+        guard !forceFailure || (arm == "Y" && maxCalls == 2) else {
+            XCTFail("D2 deliberate failure is permitted only in the two-call Y harness")
+            return
+        }
+        let previousContinue = continueAfterFailure
+        continueAfterFailure = true
+        let previousOrientation = XCUIDevice.shared.orientation
+        defer {
+            XCUIDevice.shared.orientation = previousOrientation
+            continueAfterFailure = previousContinue
+        }
+        let expected = CoverageSettings(appearance: "light", contentSize: "large", orientation: "portrait",
+                                        boldText: false, reduceMotion: false, increaseContrast: false)
+        XCUIDevice.shared.orientation = .portrait
+        let app = launchForCoverageObservation(scenario: "copyConfirmation")
+        defer { app.terminate() }
+        guard waitForCoverageState(in: app, scenario: "copyConfirmation"),
+              assertRequestedOrientation(in: app, requested: "portrait"),
+              let observed = observedSettings(in: app),
+              requireCoverage(observed == expected, "D2 observed settings differ: \(observed.payload)") else { return }
+        emitJSON(marker: "ACE_D2_SETTINGS", payload: ["observed": observed.payload, "arm": arm])
+        let caseID = "pilot.iPhone-17.copyConfirmation.light.large.portrait.0.0.0"
+        var screenshots: [String] = []
+        captureCoverageViewport(in: app, caseID: caseID, viewport: "initial", screenshots: &screenshots)
+        let copy = app.buttons["Copy action 1"]
+        let scroll = app.scrollViews.firstMatch
+        d2InitialAudit(in: app, copy: copy, scroll: scroll, arm: arm)
+
+        scrollUntilVisible(copy, in: app, field: "Copy action 1")
+        guard verifyActionTarget(copy, name: "Copy action 1") else { return }
+        copy.tap()
+        let confirmation = coverageElement(in: app, labeled: "Copied Action 1.")
+        guard requireCoverage(confirmation.waitForExistence(timeout: 5), "Copy confirmation is missing") else { return }
+        scrollUntilVisible(confirmation, in: app, field: "Copy confirmation")
+        guard requireCoverage(isFullyVisible(confirmation, in: scroll), "Copy confirmation must be visible") else { return }
+        captureCoverageViewport(in: app, caseID: caseID, viewport: "copy-confirmation", screenshots: &screenshots)
+
+        for call in 1...maxCalls {
+            if call >= 2 {
+                drag(scroll, upward: true)
+                Thread.sleep(forTimeInterval: 0.5)
+            }
+            if d2PostCopyAudit(in: app, copy: copy, scroll: scroll, arm: arm, call: call) { return }
+            if forceFailure && call == 2 { XCTFail("D2 deliberate harness failure") }
+        }
+    }
