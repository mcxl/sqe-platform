+#if DEBUG
+@MainActor
+private enum AuditLifecycleTrace {
+    private static let logger = Logger(subsystem: "com.auditco.ace.audit-diagnostic", category: "lifecycle")
+
+    static func write(_ event: String) {
+        guard UITestScenario.current != nil else { return }
+        let application = UIApplication.shared
+        let windows = application.connectedScenes.compactMap { $0 as? UIWindowScene }.flatMap(\.windows)
+        let visibleLevels = windows.filter { !$0.isHidden }.map { String(describing: $0.windowLevel.rawValue) }.joined(separator: ",")
+        logger.notice("\(event, privacy: .public) epoch=\(Date().timeIntervalSince1970, privacy: .public) appState=\(application.applicationState.rawValue, privacy: .public) visibleWindowLevels=\(visibleLevels, privacy: .public)")
+    }
+}
+#endif
