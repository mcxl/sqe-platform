     func sceneWillResignActive(_ scene: UIScene) {
+        #if DEBUG
+        AuditLifecycleTrace.write("scene-will-resign")
+        #endif
         guard let windowScene = scene as? UIWindowScene else { return }
         let cover = UIWindow(windowScene: windowScene)
         cover.windowLevel = .alert + 1
         cover.rootViewController = UIHostingController(rootView: PrivacyCoverView())
         UIView.performWithoutAnimation { cover.isHidden = false }
         self.cover = cover
+        #if DEBUG
+        AuditLifecycleTrace.write("privacy-cover-shown")
+        #endif
     }
 
     func sceneDidBecomeActive(_ scene: UIScene) {
+        #if DEBUG
+        AuditLifecycleTrace.write("scene-did-become-active")
+        #endif
         guard let cover else { return }
         UIView.performWithoutAnimation { cover.isHidden = true }
         self.cover = nil
+        #if DEBUG
+        AuditLifecycleTrace.write("privacy-cover-removed")
+        #endif
     }
