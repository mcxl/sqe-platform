+            "devices": {"iPhone 17": {"udid": "A"}, "iPhone 17 Pro Max": {"udid": "B"}},
+        }
+        after = deepcopy(before)
+        after["runtime"]["lastUsage"]["x86_64"] = "2026-09-14T22:20:13Z"
+        before_raw, after_raw = deepcopy(before), deepcopy(after)
