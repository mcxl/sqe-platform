+    // Only this counter crosses into the audit callback; all access holds its mutex.
+    private final class D1IssueCounter: Sendable {
+        private let count = Mutex<Int>(0)
+
+        func recordIssue() { count.withLock { $0 += 1 } }
+        var value: Int { count.withLock { $0 } }
+    }
+
+    private final class D1AuditSession {
+        let configuration: D1AuditConfiguration
+        private let expectedAuditCallsPerViewport: Int
+        private var attemptedAuditCalls = 0
+        private var returnedNormallyAuditCalls = 0
+        private var returnedNormallyCallsByViewport: [String: Int] = [:]
+        let issueCounter = D1IssueCounter()
+        private var auditErrors: [String] = []
+
+        init(configuration: D1AuditConfiguration) {
+            self.configuration = configuration
+            self.expectedAuditCallsPerViewport = configuration.arm == .splitAudits ? 7 : 1
+        }
+
+        func recordAuditCompletion(viewport: String, returnedNormally: Bool) {
+            attemptedAuditCalls += 1
+            if returnedNormally {
+                returnedNormallyAuditCalls += 1
+                returnedNormallyCallsByViewport[viewport, default: 0] += 1
+            }
+        }
+
+        func recordAuditError(_ error: Error) {
+            auditErrors.append(String(error.localizedDescription.prefix(256)))
+        }
+
+        var callbackIssueCount: Int { issueCounter.value }
+        var hasIssues: Bool { callbackIssueCount > 0 }
+        var hasAuditErrors: Bool { !auditErrors.isEmpty }
+
+        func completionPayload() -> [String: Any] {
+            let expectedViewports: Set<String> = ["initial", "copy-confirmation"]
+            let completedViewports = Set(returnedNormallyCallsByViewport.compactMap {
+                $0.value == expectedAuditCallsPerViewport ? $0.key : nil
+            })
+            let expectedAuditCalls = expectedAuditCallsPerViewport * expectedViewports.count
+            return [
+                "arm": configuration.arm.rawValue,
+                "repetition": configuration.repetition,
+                "expectedAuditCalls": expectedAuditCalls,
+                "attemptedAuditCalls": attemptedAuditCalls,
+                "returnedNormallyAuditCalls": returnedNormallyAuditCalls,
+                "completedViewports": completedViewports.sorted(),
+                "bothViewportAuditGroupsCompleted": completedViewports == expectedViewports,
+                "allAuditTypesAttempted": attemptedAuditCalls == expectedAuditCalls,
+                "allAuditCallsReturnedNormally": returnedNormallyAuditCalls == expectedAuditCalls,
+                "callbackIssueCount": callbackIssueCount,
+                "auditErrors": auditErrors
+            ]
+        }
+    }
+
