+                return false
+            }
+            let session = D1AuditSession(configuration: d1Configuration)
+            activeD1Session = session
+            originalContinueAfterFailure = continueAfterFailure
+            d1AuditSession = session
+            // The handler still returns false. This only lets every approved D1 audit call finish.
+            continueAfterFailure = true
