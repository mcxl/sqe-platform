+def verify_discovery_screenshots(names: list[str], attachments: Path) -> None:
+    """Validate retained PNG contents as well as their native attachment names."""
+    for exported in screenshot_exports(names, attachments):
+        try:
+            data = (attachments / exported).read_bytes()
+            if not data.startswith(b"\x89PNG\r\n\x1a\n"):
+                raise ValueError("PNG signature")
+            offset, kinds, compressed = 8, [], bytearray()
+            while offset < len(data):
+                size = int.from_bytes(data[offset:offset + 4], "big")
+                end = offset + size + 12
+                if end > len(data) or end - offset < 12:
+                    raise ValueError("PNG chunk length")
+                kind = data[offset + 4:offset + 8]
+                content = data[offset + 8:end - 4]
+                if zlib.crc32(kind + content) != int.from_bytes(data[end - 4:end], "big"):
+                    raise ValueError("PNG checksum")
+                kinds.append(kind)
+                if kind == b"IHDR":
+                    if size != 13:
+                        raise ValueError("PNG header")
+                    width, height = int.from_bytes(content[:4], "big"), int.from_bytes(content[4:8], "big")
+                    depth, colour, compression, filtering, interlace = content[8:]
+                    if (width == 0 or height == 0 or depth != 8 or colour not in (2, 6)
+                            or compression != 0 or filtering != 0 or interlace != 0):
+                        raise ValueError("unsupported native screenshot PNG header")
+                    row_bytes = width * (3 if colour == 2 else 4) + 1
+                    expected_bytes = height * row_bytes
+                if kind == b"IDAT":
+                    compressed.extend(content)
+                offset = end
+            if not kinds or kinds[0] != b"IHDR" or kinds[-1] != b"IEND" or kinds.count(b"IHDR") != 1 or kinds.count(b"IEND") != 1:
+                raise ValueError("PNG structure")
+            decoder = zlib.decompressobj()
+            pixels = decoder.decompress(bytes(compressed), expected_bytes + 1)
+            if (len(pixels) != expected_bytes or not decoder.eof or decoder.unused_data or decoder.unconsumed_tail
+                    or any(pixels[offset] > 4 for offset in range(0, expected_bytes, row_bytes))):
+                raise ValueError("PNG image scanlines")
+        except (OSError, ValueError, zlib.error) as error:
+            raise RunnerError("discovery screenshot is unreadable or corrupt") from error
