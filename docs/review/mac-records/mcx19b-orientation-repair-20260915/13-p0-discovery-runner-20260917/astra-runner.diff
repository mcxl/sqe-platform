+    # Require the native assertion location and test completion, not exit 65 alone.
+    assertion_pattern = r"^.+/ACEClientAppUITests[.]swift:[0-9]+: error: -\[ACEClientAppUITests[.]ACEClientAppUITests testCoverageBatch\] : (.+)$"
+    assertions = re.findall(assertion_pattern, text, flags=re.MULTILINE)
+    error_lines = [line for line in text.splitlines() if "error:" in line]
+    if (sorted(assertions) != sorted(failure["failureText"] for failure in failures)
+            or len(error_lines) != len(assertions)
+            or len(re.findall(r"Test Case '-\[ACEClientAppUITests[.]ACEClientAppUITests testCoverageBatch\]' failed \([0-9.]+ seconds\)[.]", text)) != 1
+            or re.search(r"Testing failed:|Failed to launch|failed to launch|Early unexpected exit|Lost connection|lost connection|crashed|timed out|TEST EXECUTE INTERRUPTED", text)):
+        raise RunnerError("discovery native log does not prove an isolated audit assertion")
+    # This capture occurs only after launch, state and observed-settings checks.
+    screenshot_names = sorted({f"Coverage {case.id} viewport initial", *(
+        f"Coverage {case.id} viewport {finding['scenario'][len(case.scenario) + 1:]}" for finding in findings)})
+    verify_discovery_screenshots(screenshot_names, attachments)
+    return {"status": "failed", "classification": "native-accessibility-assertion", "nativeSummary": payload,
+            "caseRecords": [], "auditFindings": findings, "nativeAssertions": error_lines,
+            "screenshots": screenshot_names, "auditInvocationCount": None,
+            "auditCompletion": "interrupted-by-native-assertion"}
