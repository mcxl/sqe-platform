+def discovery_summary(cases: tuple[Case, ...], candidate_record: object, records: list[dict[str, object]],
+                      error: str | None = None) -> dict[str, object]:
+    passed = sum(record.get("status") == "passed" for record in records)
+    failed = sum(record.get("status") == "failed" for record in records)
+    return {"mode": "pilot-discovery", "status": "blocked" if error else ("completed-with-failures" if failed else "completed"),
+            "acceptanceEligible": False, "candidate": candidate_record, "caseCount": len(cases),
+            "completedCaseCount": passed + failed, "passedCaseCount": passed, "failedCaseCount": failed,
+            "remainingCaseCount": len(cases) - passed - failed, "cases": records, "error": error}
+
+
+def run_discovery(cases: tuple[Case, ...], evidence: Path, frozen_candidate: dict[str, object] | None = None) -> dict[str, object]:
+    """Build once, execute independent cases, and retain blocked or completed outcomes."""
+    try:
+        result = run_coverage(cases, evidence, frozen_candidate=frozen_candidate, discovery=True)
+    except RunnerError as error:
+        records: list[dict[str, object]] = []
+        failure = evidence / "coverage-final-failure.json"
+        if failure.is_file():
+            records = _load_object(failure, "discovery failure").get("completedBatches", [])
+        summary = discovery_summary(cases, frozen_candidate, records, str(error))
+        (evidence / "discovery-summary.json").write_text(json.dumps(summary, indent=2, sort_keys=True), encoding="utf-8")
+        raise
+    summary = {**result, **discovery_summary(cases, result["candidate"], result["batches"])}
+    summary["completedAuditInvocationCount"] = summary.pop("auditInvocationCount")
+    summary["auditInvocationCount"] = None if summary["failedCaseCount"] else summary["completedAuditInvocationCount"]
+    (evidence / "discovery-summary.json").write_text(json.dumps(summary, indent=2, sort_keys=True), encoding="utf-8")
+    return summary
+
