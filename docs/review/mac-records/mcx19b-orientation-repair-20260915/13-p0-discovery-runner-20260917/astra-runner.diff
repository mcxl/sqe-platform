+def discovery_native_result(bundle: Path, summary_path: Path, log: Path, attachments: Path,
+                            case: Case, process: dict[str, object]) -> dict[str, object]:
+    """Continue only positively evidenced audit assertions; ambiguous faults block."""
+    response = checked(["xcrun", "xcresulttool", "get", "test-results", "summary", "--path", str(bundle)], timeout=120)
+    try:
+        payload = json.loads(str(response["stdout"]))
+    except json.JSONDecodeError as error:
+        raise RunnerError("discovery native result summary is invalid") from error
+    summary_path.write_text(json.dumps(payload, indent=2, sort_keys=True), encoding="utf-8")
+    fields = ("totalTestCount", "passedTests", "failedTests", "skippedTests", "expectedFailures")
+    if (not isinstance(payload, dict) or any(type(payload.get(key)) is not int for key in fields)
+            or payload["totalTestCount"] != 1 or payload["skippedTests"] != 0 or payload["expectedFailures"] != 0
+            or (payload["passedTests"], payload["failedTests"], payload.get("result")) not in ((1, 0, "Passed"), (0, 1, "Failed"))):
+        raise RunnerError("discovery native counts are incomplete, skipped or unexpected")
+    if process.get("timedOut") is not False or process.get("error") or process.get("exit") != (0 if payload["result"] == "Passed" else 65):
+        raise RunnerError("discovery native process outcome is ambiguous")
+    try:
+        text = log.read_text(encoding="utf-8")
+    except (OSError, UnicodeError) as error:
+        raise RunnerError("discovery native log is unreadable or corrupt") from error
+    records = marker_records(log, CASE_MARKER)
+    if payload["result"] == "Passed":
+        verify_case_markers((case,), records)
+        verify_screenshot_attachments(records, attachments)
+        if payload.get("testFailures") not in (None, []):
+            raise RunnerError("passed discovery summary contains unexpected failures")
+        verify_discovery_screenshots(records[0]["screenshots"], attachments)
+        return {"status": "passed", "classification": "complete-pass", "nativeSummary": payload,
+                "caseRecords": records, "auditFindings": []}
+    if records:
+        raise RunnerError("failed discovery test contains unexpected completion markers")
+    failures = payload.get("testFailures")
+    findings = marker_records(log, "ACE_A11Y_ISSUE ")
+    if (not case.audit or not isinstance(failures, list) or not failures or not findings
+            or any(not isinstance(failure, dict) or failure.get("targetName") != "ACEClientAppUITests"
+                   or failure.get("testIdentifierString") != "ACEClientAppUITests/testCoverageBatch()"
+                   or not isinstance(failure.get("failureText"), str) or not failure["failureText"] for failure in failures)
+            or any(not isinstance(finding.get("scenario"), str) or not finding["scenario"].startswith(case.scenario + "-")
+                   or not isinstance(finding.get("compactDescription"), str) or not finding["compactDescription"]
+                   or not isinstance(finding.get("detailedDescription"), str) or not finding["detailedDescription"]
+                   or not isinstance(finding.get("auditType"), str) or not isinstance(finding.get("element"), dict) for finding in findings)
